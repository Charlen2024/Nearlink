<Window
    x:Class="Nearlink.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nearlink.Native"
    Title="Nearlink">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="3" Background="{ThemeResource LayerFillColorDefaultBrush}" IsHitTestVisible="False" />
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Padding="12,0,0,0">
                <Button x:Name="BackPageButton" Style="{ThemeResource SubtleButtonStyle}" Click="BackPage_Click" IsEnabled="False" ToolTipService.ToolTip="后退">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button x:Name="ForwardPageButton" Style="{ThemeResource SubtleButtonStyle}" Click="ForwardPage_Click" IsEnabled="False" ToolTipService.ToolTip="前进">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <Button x:Name="ToggleSidebarButton" Style="{ThemeResource SubtleButtonStyle}" Click="ToggleSidebar_Click" ToolTipService.ToolTip="隐藏设备侧栏">
                    <FontIcon x:Name="SidebarPaneIcon" Glyph="&#xE89F;" FontSize="15" />
                </Button>
                <MenuBar x:Name="MainMenuBar" VerticalAlignment="Center">
                    <MenuBarItem Title="连接">
                        <MenuFlyoutItem Text="复制配对链接" Click="CopyLink_Click" />
                        <MenuFlyoutItem x:Name="ToggleQrMenuItem" Text="收起二维码" Click="ToggleQr_Click" />
                        <MenuFlyoutItem x:Name="ToggleSidebarMenuItem" Text="隐藏设备侧栏" Click="ToggleSidebar_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="传输">
                        <MenuFlyoutItem Text="消息记录" Click="NavChat_Click" />
                        <MenuFlyoutItem Text="文件列表" Click="NavFiles_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="选择文件发送…" Click="Attach_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="设备">
                        <MenuFlyoutItem Text="已配对设备" Click="NavDevices_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="设置">
                        <MenuFlyoutItem Text="打开设置" Click="NavSettings_Click" />
                    </MenuBarItem>
                    <MenuBarItem Title="关于">
                        <MenuFlyoutItem Text="检查更新" Click="CheckUpdates_Click" />
                        <MenuFlyoutItem Text="关于 Nearlink" Click="About_Click" />
                    </MenuBarItem>
                </MenuBar>
            </StackPanel>
        </Grid>

        <SplitView x:Name="AppSplitView" Grid.Row="1" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="320" CompactPaneLength="0">
            <SplitView.Pane>
                <Grid Padding="20,18,16,18" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="添加设备" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="手机扫码连接，电脑可自动发现" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="ToggleQrButton" Grid.Column="1" Style="{ThemeResource SubtleButtonStyle}" Click="ToggleQr_Click" ToolTipService.ToolTip="收起二维码">
                                    <FontIcon x:Name="QrChevronIcon" Glyph="&#xE70D;" FontSize="12" />
                                </Button>
                            </Grid>
                            <Grid x:Name="QrImagePanel" Height="168" HorizontalAlignment="Center">
                                <Image x:Name="QrImage" Width="168" Height="168" Stretch="Uniform" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                <TextBlock Text="配对码" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="PairCodeText" Text="--------" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="LinkText" Text="正在启动局域网服务…" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" x:Name="CopyLinkButton" Content="复制" Click="CopyLink_Click" Style="{ThemeResource AccentButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,14,0">
                        <StackPanel Spacing="7" Padding="0,0,6,0">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="10,12" Margin="0,0,0,7">
                                <StackPanel HorizontalAlignment="Stretch" Spacing="2">
                                    <Grid x:Name="RadarStage" Width="220" Height="142" HorizontalAlignment="Center">
                                        <Grid.Resources>
                                            <Storyboard x:Name="RadarPulseStoryboard">
                                                <DoubleAnimation Storyboard.TargetName="RadarPulse" Storyboard.TargetProperty="Opacity" From="0.55" To="0" Duration="0:0:1.9" RepeatBehavior="Forever" />
                                                <DoubleAnimation Storyboard.TargetName="RadarPulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="3.2" Duration="0:0:1.9" RepeatBehavior="Forever" />
                                                <DoubleAnimation Storyboard.TargetName="RadarPulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="3.2" Duration="0:0:1.9" RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </Grid.Resources>
                                        <Ellipse Width="136" Height="136" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                        <Ellipse Width="100" Height="100" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1" />
                                        <Ellipse Width="64" Height="64" Stroke="{ThemeResource AccentFillColorSecondaryBrush}" StrokeThickness="1.5" />
                                        <Ellipse x:Name="RadarPulse" Width="24" Height="24" Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.55" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="RadarPulseScale" CenterX="12" CenterY="12" ScaleX="1" ScaleY="1" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="12" Height="12" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Ellipse Width="7" Height="7" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0" />
                                    </Grid>
                                    <TextBlock Text="正在搜索附近的设备" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="同一局域网内的电脑和手机会显示在这里" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Grid Margin="2,12,2,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="搜索到的设备" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="NearbyDeviceCountText" Grid.Column="1" Text="搜索中…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="EmptyNearbyText" Text="正在查找同一局域网内可连接的 Nearlink 设备…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,4,4,8" TextWrapping="Wrap" />
                            <ListView x:Name="NearbyDeviceList" ItemsSource="{x:Bind NearbyDevices}" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,5">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Tag="{Binding}" Content="{Binding ActionText}" Click="ConnectNearby_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="局域网直连 · 文件保存在此电脑" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,14,0,0" />
                </Grid>
            </SplitView.Pane>

            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid x:Name="ChatPage" Visibility="Visible" AllowDrop="True" DragEnter="ChatPage_DragEnter" DragLeave="ChatPage_DragLeave" DragOver="ChatPage_DragOver" Drop="ChatPage_Drop">
                    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="设备互传" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusText" Text="正在启动…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ConversationSelector" Grid.Column="1" MinWidth="180" MaxWidth="300" SelectionChanged="ConversationSelector_SelectionChanged" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ListView x:Name="MessagesList" Grid.Row="1" ItemsSource="{x:Bind Messages}" Background="Transparent" BorderThickness="0" Padding="22,18" SelectionMode="None" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                    <Border Background="{Binding BubbleBrush}" HorizontalAlignment="{Binding Alignment}" CornerRadius="12" Padding="12" MaxWidth="440">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" MaxWidth="400" IsTextSelectionEnabled="True" Visibility="{Binding TextVisibility}" />
                                            <Border CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}" HorizontalAlignment="Left" Padding="2" Visibility="{Binding ImageVisibility}">
                                                <Image Source="{Binding PreviewImage}" MaxWidth="280" MaxHeight="250" Stretch="Uniform" Tapped="ImagePreview_Tapped" />
                                            </Border>
                                            <Button Tag="{Binding}" Click="Download_Click" HorizontalAlignment="Stretch" Style="{ThemeResource SubtleButtonStyle}" Padding="10,8" Visibility="{Binding FileVisibility}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE896;" FontSize="15" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="330" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FileSize}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="TransferStatusText" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button Content="添加文件" Click="Attach_Click" Style="{ThemeResource SubtleButtonStyle}" />
                                <TextBox x:Name="MessageInput" Grid.Column="1" PlaceholderText="输入消息…" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" KeyDown="MessageInput_KeyDown" />
                                <Button Grid.Column="2" Content="发送" Click="Send_Click" Style="{ThemeResource AccentButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="DropHintBorder" Grid.RowSpan="3" Margin="18" CornerRadius="16" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.94" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon Glyph="&#xE898;" FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="松开鼠标发送文件" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="支持一次拖入多个文件" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="FilesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="文件" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="本次会话收发的文件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Padding="18,12" ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="FilesSelectionText" Text="已选 0 项 · 共 0 项" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Content="全选" Click="SelectAllFiles_Click" Style="{ThemeResource SubtleButtonStyle}" />
                        <Button Grid.Column="2" Content="取消选择" Click="ClearFileSelection_Click" Style="{ThemeResource SubtleButtonStyle}" />
                        <TextBlock x:Name="FilesOperationStatusText" Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="8,0" />
                        <Button x:Name="RemoveSelectedFilesButton" Grid.Column="4" Content="从列表移除" Click="RemoveSelectedFiles_Click" IsEnabled="False" Style="{ThemeResource SubtleButtonStyle}" Margin="0,0,8,0" />
                        <Button x:Name="SaveSelectedFilesButton" Grid.Column="5" Content="批量保存" Click="SaveSelectedFiles_Click" IsEnabled="False" Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>
                    <ListView x:Name="FilesList" Grid.Row="2" ItemsSource="{x:Bind Files}" Background="Transparent" BorderThickness="0" Padding="18,0,18,18" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="14" Padding="10,10" MinHeight="76">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="56" Height="56" CornerRadius="7" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="2" VerticalAlignment="Center">
                                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" Visibility="{Binding ThumbnailVisibility}" />
                                    </Border>
                                    <FontIcon Grid.Column="1" Glyph="&#xE8A5;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FileIconVisibility}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MetaWithSize}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="DevicesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="已配对设备" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="PairedDevicesSubtitle" Text="电脑和手机的配对记录" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="ToggleDeviceEditButton" Grid.Column="1" Content="编辑" Click="ToggleDeviceEdit_Click" Style="{ThemeResource SubtleButtonStyle}" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="18,14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock x:Name="EmptyPairedDevicesText" Text="还没有配对设备。附近设备会出现在连接侧栏。" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,4,4,12" TextWrapping="Wrap" />
                        <ListView x:Name="PairedDevicesList" Grid.Row="1" ItemsSource="{x:Bind PairedDevices}" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Visibility="{Binding EditVisibility}" VerticalAlignment="Center" />
                                            <FontIcon Grid.Column="1" Glyph="{Binding IconGlyph}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Border x:Name="DeviceEditActions" Grid.Row="2" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="18,12" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DeviceSelectionText" Text="已选择 0 台" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="RemoveSelectedDevicesButton" Grid.Column="1" Content="移除所选（0）" Click="RemoveSelectedDevices_Click" IsEnabled="False" Style="{ThemeResource AccentButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                        <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="外观、传输和更多选项" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="14,8" ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="SettingsNavigation" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0,4" SelectionMode="Single" SelectionChanged="SettingsNavigation_SelectionChanged">
                            <ListViewItem Tag="appearance" Padding="12,13">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE790;" /><TextBlock Text="外观" VerticalAlignment="Center" /></StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="identity" Padding="12,13">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE772;" /><TextBlock Text="设备标识" VerticalAlignment="Center" /></StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="transfer" Padding="12,13">
                                <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE896;" /><TextBlock Text="传输" VerticalAlignment="Center" /></StackPanel>
                            </ListViewItem>
                        </ListView>
                        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8" />
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="12,0,0,0">
                            <Grid Padding="22,18">
                                <StackPanel x:Name="AppearanceSettingsSection" Spacing="14" MaxWidth="700" HorizontalAlignment="Left">
                                    <TextBlock Text="主题" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="选择界面颜色，也可以跟随 Windows 的应用模式设置。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <RadioButton x:Name="ThemeSystemRadio" GroupName="ThemeMode" Tag="System" Content="跟随系统设置" Checked="ThemeMode_Checked" />
                                    <RadioButton x:Name="ThemeLightRadio" GroupName="ThemeMode" Tag="Light" Content="浅色" Checked="ThemeMode_Checked" />
                                    <RadioButton x:Name="ThemeDarkRadio" GroupName="ThemeMode" Tag="Dark" Content="深色" Checked="ThemeMode_Checked" />
                                </StackPanel>
                                <StackPanel x:Name="DeviceIdentitySettingsSection" Spacing="12" MaxWidth="700" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <TextBlock Text="这台电脑的标识" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="此名称会显示在已连接的手机和电脑上。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBox x:Name="DeviceNameTextBox" PlaceholderText="例如：书房电脑" MaxLength="32" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="保存标识" Click="SaveDeviceName_Click" Style="{ThemeResource AccentButtonStyle}" />
                                        <TextBlock x:Name="DeviceNameSaveStatus" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="TransferSettingsSection" Spacing="12" MaxWidth="700" HorizontalAlignment="Left" Visibility="Collapsed">
                                    <TextBlock Text="本地传输" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="消息和文件仅在同一局域网内传输，不经过云端。文件保存在此电脑。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,6,0,2">
                                        <StackPanel Spacing="5">
                                            <ToggleSwitch x:Name="ExplorerContextMenuToggle" Header="资源管理器右键发送" OnContent="已开启" OffContent="已关闭" Toggled="ExplorerContextMenuToggle_Toggled" />
                                            <TextBlock Text="右键文件选择“发送到 Nearlink”，可发送给已连接的手机群组或配对电脑。支持多选。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,0" />
                                            <TextBlock x:Name="ExplorerContextMenuStatus" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="配对地址" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="SettingsLinkText" TextWrapping="Wrap" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </SplitView>
    </Grid>
</Window>
